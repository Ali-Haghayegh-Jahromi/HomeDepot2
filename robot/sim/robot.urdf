<?xml version="1.0"?>
<!-- The guide robot: a small wheeled base with a tall mast and a sign, so
     customers can follow it down an aisle. -->
<robot name="guide_robot">
  <material name="orange"><color rgba="0.976 0.388 0.008 1"/></material>
  <material name="dark"><color rgba="0.12 0.12 0.14 1"/></material>
  <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="blue"><color rgba="0.1 0.5 1.0 1"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.16"/><geometry><cylinder radius="0.3" length="0.22"/></geometry><material name="orange"/></visual>
    <visual><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.27" length="0.04"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0 0.25 0.07"/><geometry><cylinder radius="0.07" length="0.05"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0 -0.25 0.07"/><geometry><cylinder radius="0.07" length="0.05"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0.24 0 0.2"/><geometry><box size="0.1 0.3 0.06"/></geometry><material name="white"/></visual>
  </link>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>

  <link name="base_scan">
    <visual><geometry><cylinder radius="0.05" length="0.06"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="scan_joint" type="fixed"><parent link="base_link"/><child link="base_scan"/><origin xyz="0 0 0.31"/></joint>

  <link name="mast">
    <visual><origin xyz="0 0 0.55"/><geometry><cylinder radius="0.025" length="1.1"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0 0 1.2"/><geometry><box size="0.04 0.5 0.3"/></geometry><material name="orange"/></visual>
    <visual><origin xyz="0 0 1.42"/><geometry><sphere radius="0.07"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="mast_joint" type="fixed"><parent link="base_link"/><child link="mast"/><origin xyz="-0.12 0 0.27"/></joint>
</robot>
