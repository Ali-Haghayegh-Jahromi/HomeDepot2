# Settings of the Aisle Guide demo. ./start.sh made this file and fills in anything missing.
# You may edit it; run ./start.sh again afterwards. Keep it private: it holds your API key.

# --- AI ---------------------------------------------------------------------
# gemini = the real AI (needs GEMINI_API_KEY, or a key already saved in n8n)
# offline = a simple stand-in that needs no key and no internet (it understands only a few
#           repair jobs: decks, toilets, wall holes, leaking faucets, painting, hanging things)
# (auto = not decided yet: the first ./start.sh picks gemini if n8n already has a key, else offline)
# To change the key or the mode, run:  ./start.sh key
HD_AI=
GEMINI_API_KEY=
# Optional backup AI, only used together with Gemini (not in offline mode): Claude (Anthropic). When every Gemini model is out of its free quota or busy, the
# workflow asks Claude instead of telling the customer to try again. Key: https://console.anthropic.com/settings/keys
# (paid per use). Add or change it with:  ./start.sh claude-key   (start.sh asks once; HD_CLAUDE_ASKED remembers that)
ANTHROPIC_API_KEY=
HD_CLAUDE_ASKED=
# Which AI goes first: gemini (default; Claude is the backup) or claude (Claude first, Gemini as the backup).
HD_AI_PROVIDER=
# The Gemini models to try, in order (empty = the workflow's list: gemini-flash-lite-latest, gemini-3.1-flash-lite,
# gemini-3-flash-preview, gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.6-flash). Each has its own free quota.
HD_GEMINI_MODELS=

# --- n8n login (the account is created automatically on the first start) -----
N8N_OWNER_EMAIL=demo@aisleguide.local
N8N_OWNER_PASSWORD=

# --- A real phone on the same Wi-Fi --------------------------------------------
# HD_LAN=yes: phones on the same Wi-Fi can open the demo, and the QR code uses this computer's
#   network address (or run ./start.sh lan). HD_PUBLIC_HOST is that address; leave it empty to
#   find it automatically.
# HD_HTTPS=yes: the same over https (port HD_HTTPS_PORT), so the phone's voice notes work too.
#   Each phone shows a warning once (a self-signed certificate): see QUICKSTART.md. (./start.sh https)
HD_LAN=no
HD_HTTPS=no
HD_PUBLIC_HOST=

# --- The robot view (RViz) in the browser ---------------------------------------
# HD_RVIZ=no skips it (saves computer power; the demo stage's map still shows the robot)
# HD_RVIZ_VIEW: top = the whole store from above, framed for recording; 3d = the 3D store
HD_RVIZ=yes
HD_RVIZ_VIEW=top

# --- Ports on this computer (./start.sh lists any that another program uses, with new lines to put here) ---
HD_DEMO_PORT=8000
HD_N8N_PORT=5678
HD_RVIZ_PORT=6080
HD_HTTPS_PORT=8443

# --- Database (made-up demo passwords, generated on the first start) -----------
POSTGRES_USER=hd_app
POSTGRES_PASSWORD=
POSTGRES_DB=homedepot
HD_LLM_READER_PASSWORD=

# Time zone for n8n and the logs (found automatically)
TZ=
