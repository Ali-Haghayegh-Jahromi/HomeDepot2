# RViz for recording (HD_RVIZ_VIEW=top, the default): a top view of the whole 60 x 40 m store,
# drawn like the web map on the demo stage (x to the right, y to the back of the store: the
# entrance and registers at the bottom, aisle 1 on the left), filling the 1920x1080 screen that
# noVNC shows. No panels; the entrypoint switches RViz to full screen (F11), which also hides the
# menu, the toolbar and the status bar. The 3D camera is in record-3d.rviz (HD_RVIZ_VIEW=3d).
# The topics are the same as in robot/sim/store.rviz.
Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.2
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Store map (Nav2)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Store (racks, kiosk, dock, signs)
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /store/markers
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/LaserScan
      Color: 80; 170; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Laser scan
      Size (Pixels): 2
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      # the theme's success green (--color-success), bold enough to follow on a recording
      Color: 21; 128; 61
      Enabled: true
      Line Style: Billboards
      Line Width: 0.5
      Name: Planned route
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Shelf-tag lights
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /shelf_lights
      Value: true
    # The robot's big green footprint and heading arrow come with the store markers
    # (robot/sim/sim_robot.py, namespace robot_footprint), locked to the robot's TF frame.
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: Guide robot
      Visual Enabled: true
      Value: true
  Enabled: true
  Global Options:
    # white, as the studio view's card around RViz and the web map's floor: no dark bars
    Background Color: 255; 255; 255
    Fixed Frame: map
    Frame Rate: 12
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Name: Current View
      Near Clip Distance: 0.01
      # pixels per metre: the store's 60 m width (and a little margin) fills the 1920 px screen;
      # in height that shows the front wall to the back of the racks (34 m), cutting off only the
      # empty receiving area behind them
      Scale: 30.8
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 30
      Y: 17.2
    Saved: ~
Window Geometry:
  Height: 1080
  Hide Left Dock: true
  Hide Right Dock: true
  Width: 1920
  X: 0
  Y: 0
